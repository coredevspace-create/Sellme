# Copie ce fichier en .env puis renseigne ta clé.

# Fournisseur : openai (par défaut) ou gemini
LLM_PROVIDER=openai

# Clé OpenAI : https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ou clé Gemini : https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Modèle (facultatif). Par défaut : gpt-5.4-mini (OpenAI) ou gemini-2.5-flash (Gemini)
# LLM_MODEL=

# PORT=3000
